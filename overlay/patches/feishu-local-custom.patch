-function resolveStartupProbeTimeoutMs(): number {
-  const raw = process.env[FEISHU_STARTUP_BOT_INFO_TIMEOUT_ENV];
-  if (raw) {
-    const parsed = Number(raw);
-    if (Number.isFinite(parsed) && parsed > 0) {
-      return Math.floor(parsed);
-    }
