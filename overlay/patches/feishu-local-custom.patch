-          }),
-          accountId,
-        });
-        completeFeishuCardActionToken({ token: event.token, accountId: account.accountId });
-        return;
-      }
-
-      if (envelope.a === FEISHU_APPROVAL_CANCEL_ACTION) {
-        await sendMessageFeishu({
-          cfg,
-          to: resolveCallbackTarget(event),
-          text: "Cancelled.",
-          accountId,
-        });
-        completeFeishuCardActionToken({ token: event.token, accountId: account.accountId });
