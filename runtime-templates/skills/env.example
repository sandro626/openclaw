# Skill runtime env templates

# Manage platform test
BMSYS_TEST_URL=https://portal.example.com/
BMSYS_TEST_USERNAME=
BMSYS_TEST_PASSWORD=
BMSYS_TEST_OTP=123456

# Chandao
CHANDAO_URL=https://chandao.example.com
CHANDAO_USERNAME=
CHANDAO_PASSWORD=
CHANDAO_FUNCTION_TESTER_USERNAME=
CHANDAO_FUNCTION_TESTER_PASSWORD=
CHANDAO_PM_USERNAME=
CHANDAO_PM_PASSWORD=
CHANDAO_BACKEND_USERNAME=
CHANDAO_BACKEND_PASSWORD=
CHANDAO_FRONTEND_USERNAME=
CHANDAO_FRONTEND_PASSWORD=
CHANDAO_PC_TEST_USERNAME=
CHANDAO_PC_TEST_PASSWORD=

# Product server SSH access
CONNECT_PRODUCT_JUMP_HOST=jump.example.com
CONNECT_PRODUCT_JUMP_USER=ubuntu
CONNECT_PRODUCT_SSH_KEY_PATH=~/.ssh/id_ed25519_product_jump
CONNECT_PRODUCT_LOG_HOST=loghost.example.com
CONNECT_PRODUCT_LOG_USER=readonly
CONNECT_PRODUCT_LOG_DIR=/var/log/app
CONNECT_PRODUCT_APP_HOST=apphost.example.com
CONNECT_PRODUCT_APP_USER=ubuntu
CONNECT_PRODUCT_APP_SERVICE=openclaw-app

# Gitee coder
GITEE_HOST=gitee.com
GITEE_DEFAULT_OWNER=
GITEE_DEFAULT_REPO=
GITEE_DEFAULT_BASE_BRANCH=master
GITEE_WORKDIR_ROOT=~/.openclaw/workspace/repos
GITEE_SSH_KEY_PATH=~/.ssh/id_ed25519_gitee

# YZ Java
YZ_JAVA_PROJECT_ROOT=~/workspace/yz-app
YZ_JAVA_NACOS_SERVER_ADDR=nacos.example.com:8848
YZ_JAVA_NACOS_DEV_NAMESPACE=yz-app-dev
YZ_JAVA_NACOS_TEST_NAMESPACE=yz-app-test
YZ_JAVA_NACOS_PROD_NAMESPACE=yz-app-prod
YZ_JAVA_CONFIG_DEPLOY_HOST=config-host.example.com
YZ_JAVA_CONFIG_DEPLOY_USER=deployer
YZ_JAVA_CONFIG_DEPLOY_DIR=/opt/yz-app/nacos-configs
# yz-build 和 yz-test-java 复用同一个 YZ_JAVA_PROJECT_ROOT

# Linear
LINEAR_API_KEY=

# Monday.com
MATON_API_KEY=

# Lark / Feishu bridge
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_SECRET_PATH=~/.openclaw/secrets/feishu_app_secret
WEBHOOK_PORT=3000
FEISHU_THINKING_THRESHOLD_MS=2500
FEISHU_ENCRYPT_KEY=
OPENCLAW_AGENT_ID=main
OPENCLAW_HOME=~/.openclaw
OPENCLAW_CONFIG_PATH=
FEISHU_API_BASE=https://open.feishu.cn/open-apis
FEISHU_ACCOUNT=
FEISHU_ACCOUNTS_CONFIG=
FEISHU_CONTACTS_DATA_DIR=
FEISHU_CONTACTS_SHARED_DIR=
FEISHU_CONTACTS_LOG_FILE=
FEISHU_CONTACTS_DOC_URL=

# Aliyun OSS
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_BUCKET=

# IMAP / SMTP
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_TLS=true
IMAP_REJECT_UNAUTHORIZED=true
IMAP_MAILBOX=INBOX
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_REJECT_UNAUTHORIZED=true

# Neynar
NEYNAR_API_KEY=
NEYNAR_SIGNER_UUID=

# Tavily
TAVILY_API_KEY=
