{
  "agents": {
    "defaults": {
      "workspace": "${OPENCLAW_WORKSPACE_ROOT:-~/.openclaw/workspace}/main",
      "model": {
        "primary": "minimax/MiniMax-M2.7"
      },
      "memorySearch": {
        "enabled": true,
        "provider": "openai",
        "model": "${OPENCLAW_MEMORY_EMBED_MODEL:-text-embedding-v4}",
        "remote": {
          "baseUrl": "${OPENCLAW_MEMORY_EMBED_BASE_URL:-https://dashscope.aliyuncs.com/compatible-mode/v1}",
          "apiKey": {
            "source": "env",
            "provider": "default",
            "id": "MODELSTUDIO_API_KEY"
          }
        }
      },
      "imageModel": {
        "primary": "zai/glm-4.6v",
        "fallbacks": []
      },
      "compaction": {
        "mode": "safeguard"
      },
      "timeoutSeconds": 1800,
      "maxConcurrent": 4,
      "subagents": {
        "maxConcurrent": 8,
        "maxSpawnDepth": 2,
        "maxChildrenPerAgent": 5
      }
    }
  }
}
