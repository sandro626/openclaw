{
  "id": "mysql-readonly",
  "name": "MySQL Readonly",
  "description": "Read-only MySQL query plugin for OpenClaw.",
  "skills": ["./skills"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "host": {
        "type": "string",
        "description": "MySQL host name or IP."
      },
      "port": {
        "type": "number",
        "description": "MySQL port."
      },
      "user": {
        "type": "string",
        "description": "Read-only MySQL username."
      },
      "password": {
        "type": "string",
        "description": "Read-only MySQL password.",
        "x-sensitive": true
      },
      "database": {
        "type": "string",
        "description": "Default MySQL database name."
      },
      "allowedTables": {
        "type": "array",
        "description": "Optional whitelist of tables that agents may inspect.",
        "items": {
          "type": "string"
        }
      },
      "connectTimeoutMs": {
        "type": "number",
        "description": "Connection timeout in milliseconds."
      },
      "queryTimeoutMs": {
        "type": "number",
        "description": "Statement timeout in milliseconds."
      },
      "maxRows": {
        "type": "number",
        "description": "Maximum rows returned to the agent."
      },
      "ssl": {
        "type": "boolean",
        "description": "Whether to require TLS for MySQL connections."
      }
    },
    "required": ["host", "user", "password", "database"]
  }
}
