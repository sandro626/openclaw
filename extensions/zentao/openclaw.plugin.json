{
  "id": "zentao",
  "name": "Zentao",
  "description": "Zentao RESTful API integration for structured work-item access and management.",
  "skills": ["./skills"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseUrl": {
        "type": "string",
        "description": "Base HTTPS URL of the Zentao instance."
      },
      "apiVersion": {
        "type": "string",
        "enum": ["v1"],
        "description": "REST API version to use."
      },
      "account": {
        "type": "string",
        "description": "Optional fallback Zentao account used when the current agent has no params.zentao mapping."
      },
      "password": {
        "type": "string",
        "description": "Optional fallback Zentao password or secret reference.",
        "x-sensitive": true
      },
      "accountsByAgent": {
        "type": "object",
        "description": "Legacy plugin-level per-agent credential map. Prefer agents.list[].params.zentao.",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "account": {
              "type": "string"
            },
            "password": {
              "type": "string",
              "x-sensitive": true
            }
          },
          "required": ["account", "password"]
        }
      },
      "verifyTls": {
        "type": "boolean",
        "description": "Whether to verify TLS certificates."
      },
      "requestTimeoutMs": {
        "type": "number",
        "description": "Per-request timeout in milliseconds."
      },
      "mode": {
        "type": "string",
        "enum": ["read-only", "read-write"],
        "description": "Whether write actions are allowed."
      },
      "allowedProducts": {
        "type": "array",
        "items": { "type": "number" }
      },
      "allowedProjects": {
        "type": "array",
        "items": { "type": "number" }
      },
      "allowedExecutions": {
        "type": "array",
        "items": { "type": "number" }
      },
      "writeGuards": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requireReason": { "type": "boolean" },
          "requireScopeMatch": { "type": "boolean" },
          "confirmBeforeDestructive": { "type": "boolean" }
        }
      }
    },
    "required": ["baseUrl"]
  }
}
