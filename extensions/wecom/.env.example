# WeCom (企业微信) Plugin Configuration Example
# 企业微信插件配置示例

# 企业配置 (必填)
WECOM_CORP_ID=ww1234567890abcdef
WECOM_AGENT_ID=1000002
WECOM_AGENT_SECRET=your_agent_secret_here

# 回调配置 (必填)
WECOM_TOKEN=wecom_token_2024
WECOM_ENCODING_AES_KEY=your_encoding_aes_key_here_43_chars_random
WECOM_WEBHOOK_URL=https://your-gateway-domain.com/wecom/webhook
WECOM_WEBHOOK_PATH=/wecom/webhook

# 访问控制 (可选)
WECOM_DM_POLICY=allowlist
WECOM_ALLOW_FROM=zhangsan,lisi,wangwu
WECOM_GROUP_POLICY=allowlist
